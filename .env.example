PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/leave_management
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - use Gmail App Password or SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Leave Management <no-reply@leaveapp.com>"
# Admin notification recipients are sourced from DB users with role=admin.
# Add/remove admins via seed.js or the admin console; no env var needed.

CLIENT_URL=http://localhost:5173
