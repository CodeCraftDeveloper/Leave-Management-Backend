PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/leave_management
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - use Gmail App Password or SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Prem Industries <no-reply@leaveapp.com>"
# Optional comma-separated override for admin leave-request notification recipients.
# If empty, notifications are sent to active DB users with role=admin.
ADMIN_EMAIL=admin@leaveapp.com

CLIENT_URL=http://localhost:5173
